# =============================================================================
# WISMO Agent. Przykładowy plik konfiguracji.
# Skopiuj do .env i uzupełnij realne wartości. NIE commituj .env do repo.
# =============================================================================

# --- n8n --------------------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_strong_password

# --- PostgreSQL -------------------------------------------------------------
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=CHANGE_ME_pg_password

# --- LLM --------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_MODEL=claude-sonnet-5
LLM_FALLBACK_MODEL=gpt-4o-mini

# --- Sklep (wybierz jedną integrację lub obie) -------------------------------
SHOPIFY_STORE=mojsklep.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...
BASELINKER_TOKEN=

# --- Przewoźnik -------------------------------------------------------------
INPOST_API_TOKEN=
DPD_API_LOGIN=
DPD_API_PASSWORD=
DHL_API_KEY=

# --- Kanały wejściowe -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_NUMBER=whatsapp:+48000000000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Human in the Loop ------------------------------------------------------
SLACK_ESCALATION_WEBHOOK=https://hooks.slack.com/services/...
FRESHDESK_API_KEY=
FRESHDESK_DOMAIN=

# --- Guardrails i limity ----------------------------------------------------
MAX_TOKENS_PER_SESSION=8000
MAX_TOOL_CALLS_PER_TURN=6
PII_REDACTION=true
LOG_LEVEL=INFO

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
